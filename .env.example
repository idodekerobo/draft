# Copy this file to .env.local and fill in the private values.
# .env.local is ignored by git; never commit credentials.

# SHARED ACROSS ALL APPS
# DRAFT_API_BASE_URL must be the HTTPS ngrok/public URL used by the backend
# scheduler and webhooks. Keep it identical for the web app, backend, desktop,
# and any external callbacks.
DRAFT_APP_URL=http://localhost:3000
DRAFT_API_BASE_URL=https://your-backend-tunnel.ngrok-free.app
DRAFT_LANDING_URL=http://localhost:3001
DRAFT_WEB_PORT=3000
DRAFT_LANDING_PORT=3001
DRAFT_BACKEND_PORT=8787

# SHARED ACROSS WEB APP, BACKEND, AND DESKTOP
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# BACKEND ONLY
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
FLY_API_TOKEN=""
FLY_APP_NAME=
FLY_SANDBOX_IMAGE=
FLY_REGION=
SANDBOX_CALLBACK_SECRET=
SPIKE2_CALLBACK_PORT=
INFERENCE_CREDENTIAL_KEK_V1=

# LANDING PAGE APP ONLY
NEXT_PUBLIC_CRISP_WEBSITE_ID=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
CRISP_HISTORY_SECRET=
CRISP_API_IDENTIFIER=
CRISP_API_KEY=

# WEB APP ONLY
# Optional customizable download link
NEXT_PUBLIC_DOWNLOAD_URL=https://github.com/idodekerobo/draft/releases/latest/download/stable-macos-arm64-Draft.dmg

# OPTIONAL BACKEND SLACK SETTINGS
# Optional customizable Slack batching settings
SLACK_BATCH_MAX_CONTENT_BYTES=
SLACK_BATCH_MAX_MESSAGES=
SLACK_BATCH_MAX_SPAN_HOURS=

# INTEGRATIONS (BACKEND ONLY)
# GitHub App credentials (backend/src/ingestion/github/client.ts), forwarded
# to the backend process by scripts/run-local.sh's backend_env array — same
# root-.env.local convention as SUPABASE_URL/FLY_API_TOKEN above.
# GITHUB_APP_PRIVATE_KEY must be PKCS#8 ("BEGIN PRIVATE KEY", not "BEGIN RSA
# PRIVATE KEY" — convert with `openssl pkcs8 -topk8 -nocrypt`), stored as one
# line with literal \n in place of real newlines.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Optional — set during a private-key rotation overlap window only.
GITHUB_APP_PRIVATE_KEY_PREVIOUS=
GITHUB_APP_WEBHOOK_SECRET=
