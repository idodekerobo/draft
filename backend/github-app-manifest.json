{
  "name": "Draft Context (dev)",
  "url": "https://draftai.us",
  "hook_attributes": {
    "url": "https://example.com/webhooks/github"
  },
  "redirect_url": "http://localhost:4756/callback",
  "setup_url": "https://example.com/workspaces/github/callback",
  "setup_on_update": true,
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "actions": "write",
    "administration": "write",
    "statuses": "write",
    "contents": "write",
    "issues": "write",
    "merge_queues": "write",
    "pages": "write",
    "repository_projects": "write",
    "pull_requests": "write",
    "repository_hooks": "write",
    "workflows": "write",
    "organization_events": "read",
    "issue_fields": "write",
    "issue_types": "write",
    "organization_projects": "write",
    "organization_hooks": "write",
    "starring": "write",
    "watching": "write"
  },
  "default_events": [
    "pull_request",
    "pull_request_review",
    "pull_request_review_comment",
    "release",
    "push",
    "meta",
    "installation_target",
    "security_advisory",
    "commit_comment",
    "create",
    "delete",
    "issues",
    "issue_comment",
    "label",
    "milestone",
    "member",
    "projects_v2",
    "projects_v2_item",
    "projects_v2_status_update",
    "repository",
    "status",
    "workflow_dispatch",
    "workflow_job",
    "workflow_run",
    "sub_issues"
  ]
}
