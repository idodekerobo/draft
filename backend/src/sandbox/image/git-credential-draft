#!/bin/sh
set -eu

operation="${1:-}"
if [ "$operation" != "get" ]; then exit 0; fi
input="$(cat)"
host="$(printf '%s\n' "$input" | sed -n 's/^host=//p' | head -n 1)"
if [ "$host" != "github.com" ]; then exit 0; fi
credential="$(/usr/local/bin/draft-github-token)" || exit 1
printf 'username=x-access-token\npassword=%s\n\n' "$credential"
